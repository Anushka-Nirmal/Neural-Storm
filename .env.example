# Database URL (Replace with your PostgreSQL / Supabase connection)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Application Security
SECRET_KEY=change_this_to_a_random_32_character_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Optional - leave empty for offline heuristic fallback)
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# CORS Allowed Origins (Comma-separated in JSON format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://jansahayak.vercel.app"]
